# ---------------------------------------------------------------
# StayVoyage — local WAMP64 configuration (C:\wamp64\www\StayVoyage)
# Copy to .env and run: php artisan key:generate
# ---------------------------------------------------------------
APP_NAME=StayVoyage
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
# Apache vhost (see docs/LOCAL_SETUP.md) serves backend/public on port 8096
APP_URL=http://localhost:8096
# Where the React SPA is reachable (same origin in the built setup; 5173 for Vite dev)
FRONTEND_URL=http://localhost:8096

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 on WAMP64
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stayvoyage
DB_USERNAME=root
DB_PASSWORD=

# Sessions / Sanctum SPA cookie auth
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:8096,127.0.0.1:8096,localhost:8000,127.0.0.1:8000,localhost:5173,127.0.0.1:5173

BROADCAST_CONNECTION=log
# Local disk only (S3 is a future production option — leave AWS_* empty)
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=stayvoyage_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=stayvoyage_
REDIS_DB=4
REDIS_CACHE_DB=5

# Free mail option: "log" writes emails to storage/logs. For Mailtrap free tier set
# MAIL_MAILER=smtp, MAIL_HOST=sandbox.smtp.mailtrap.io, MAIL_PORT=2525 + your inbox credentials.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@stayvoyage.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Payments: TEST / SANDBOX KEYS ONLY. Never put live keys here. ---
# "sandbox" = built-in StayVoyage payment simulator (works with no keys, signed callbacks).
# Set to razorpay or stripe after adding test-mode keys below.
PAYMENT_DEFAULT_GATEWAY=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Maps: OpenStreetMap + Leaflet is used by default (free, no key).
# Optionally add a free-tier Google Maps/Places key for Places autocomplete.
GOOGLE_MAPS_API_KEY=

# Seeded local-only test password (documented in README). NOT a real secret.
SEED_TEST_PASSWORD=Password@123

VITE_APP_NAME="${APP_NAME}"
